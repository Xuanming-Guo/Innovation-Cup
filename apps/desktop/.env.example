# Public build-time configuration. Production installers bake these values into the client.
# Distribution is safe only because Auth, RLS, and the FastAPI authorization boundary enforce
# access. Never place database, secret/service-role, or Gemini credentials here.
VITE_PRODUCT_NAME=Coordination Engine
VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_DEFAULT_COMPANY_ID=11111111-1111-4111-8111-111111111111
