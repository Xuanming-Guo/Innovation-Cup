# Supabase provides these automatically to hosted Edge Functions and the local CLI.
# They are shown here only to document the storage-ticket runtime contract.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_replace_me"}
SUPABASE_SECRET_KEYS={"default":"sb_secret_replace_me"}
SUPABASE_JWKS={"keys":[]}
SUPABASE_DB_URL=postgresql://postgres:replace-me@host:5432/postgres

# Application-specific, non-secret setting. Hosted default is 60 seconds.
STORAGE_DOWNLOAD_TTL_SECONDS=60
