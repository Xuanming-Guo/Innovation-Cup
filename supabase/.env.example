# Local/manual tooling only. Never prefix server secrets with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# ALTO scenario tooling automatically reads ignored supabase/.env.
# Preferred: link the intended project, leave DB_URL empty, and set its raw database
# owner password locally. Host/user/port come from ignored .temp/pooler-url metadata.
# This is operator-only: do not copy either value into runtime or desktop settings.
SUPABASE_DB_PASSWORD=
# Optional complete operator URI; overrides the linked-project password option.
# Environment variables override this file for the same setting.
SUPABASE_DB_URL=
STORAGE_DOWNLOAD_TTL_SECONDS=60

# Legacy demo operator inputs. ALTO scenario provisioning does not need these user IDs.
# The legacy demo_tenant.py script still requires explicit process environment settings.
COORDINATION_ENVIRONMENT=demo
DEMO_MANAGER_USER_ID=00000000-0000-0000-0000-000000000000
DEMO_EMPLOYEE_USER_ID=00000000-0000-0000-0000-000000000000
