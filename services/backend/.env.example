# Runtime identity
COORDINATION_ENVIRONMENT=development
COORDINATION_API_VERSION=1.0.0
COORDINATION_BUILD_COMMIT=development
COORDINATION_LOG_LEVEL=INFO
# Comma-separated explicit origins; never use * with authenticated endpoints.
COORDINATION_CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1420,http://localhost:1420

# Supabase and Postgres — server only except where explicitly labelled public
COORDINATION_SUPABASE_URL=https://your-project-ref.supabase.co
COORDINATION_SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
COORDINATION_SUPABASE_JWT_AUDIENCE=authenticated
COORDINATION_SUPABASE_JWT_ALGORITHMS=ES256,RS256
COORDINATION_SUPABASE_JWT_LEEWAY_SECONDS=30
COORDINATION_DATABASE_URL=postgresql://runtime-user:replace-me@host:5432/postgres
COORDINATION_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Google Gemini settings - server-side only
# Companies configure an API key or Vertex service account in the admin Connections screen.
# Optional local/test fallback only; production ignores this value.
COORDINATION_GEMINI_API_KEY=
COORDINATION_INTERPRETATION_MODE=gemini
COORDINATION_GEMINI_MODEL=gemini-3.8-flash
COORDINATION_VERTEX_LOCATION=global
# Optional comma-separated allowlist. Blank accepts any locally valid Google project ID.
COORDINATION_VERTEX_ALLOWED_PROJECT_IDS=
COORDINATION_GEMINI_TIMEOUT_SECONDS=20
COORDINATION_GEMINI_RETRY_ATTEMPTS=2
COORDINATION_GEMINI_MAX_OUTPUT_TOKENS=8192
COORDINATION_GEMINI_MAX_PROJECTION_CHARACTERS=150000
# Worker controls
COORDINATION_WORKER_POLL_SECONDS=5
COORDINATION_WORKER_BATCH_SIZE=4
COORDINATION_WORKER_LEASE_SECONDS=120
COORDINATION_WORKER_RENEWAL_SECONDS=30
# Optional stable instance label; defaults to the container hostname.
COORDINATION_WORKER_INSTANCE_NAME=

# Single-laptop host registrar only. The Compose launcher supplies these from
# deploy/local-host/.env and its generated .env.runtime; normal API/worker development leaves them blank.
COORDINATION_HOST_COMPANY_ID=
COORDINATION_HOST_ACTOR_ID=
COORDINATION_HOST_INSTANCE_ID=
COORDINATION_HOST_TUNNEL_LOG_PATH=/state/cloudflared.log
COORDINATION_HOST_READY_PATH=/tmp/coordination-host-registrar.ready
COORDINATION_HOST_POLL_SECONDS=2
COORDINATION_HOST_HEARTBEAT_SECONDS=30
COORDINATION_HOST_TTL_SECONDS=120
COORDINATION_HOST_HEALTH_TIMEOUT_SECONDS=10
