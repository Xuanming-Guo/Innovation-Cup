# Copy this file to deploy/local-host/.env and replace every placeholder.
# This file is host-only. Never copy its database URLs into a desktop build.

COORDINATION_SUPABASE_URL=https://your-project-ref.supabase.co
COORDINATION_API_DATABASE_URL=postgresql://coordination_api_prod.your-project-ref:URL_ENCODED_PASSWORD@your-shared-pooler-host:5432/postgres?sslmode=require
COORDINATION_WORKER_DATABASE_URL=postgresql://coordination_worker_prod.your-project-ref:URL_ENCODED_PASSWORD@your-shared-pooler-host:5432/postgres?sslmode=require
COORDINATION_HOST_COMPANY_ID=11111111-1111-4111-8111-111111111111
# Supabase Authentication -> Users -> the company_admin user's UUID.
COORDINATION_HOST_ACTOR_ID=replace-with-company-admin-auth-user-uuid
COORDINATION_GEMINI_MODEL=gemini-3.8-flash
COORDINATION_HACKATHON_DEMO=true
COORDINATION_DEMO_AI_COMMANDS_PER_MINUTE=12
COORDINATION_DEMO_AI_MODEL_CALLS_PER_MINUTE=120
COORDINATION_GEMINI_TIMEOUT_SECONDS=60
COORDINATION_GEMINI_MAX_OUTPUT_TOKENS=16384
# Full schedule generation/revision only; permits larger responses and possible
# higher output-token charges. Still at most three authoring attempts per workflow.
COORDINATION_GEMINI_PLAN_MAX_OUTPUT_TOKENS=32768
COORDINATION_VERTEX_LOCATION=global
# Optional comma-separated Google Cloud project IDs accepted by the Connections screen.
COORDINATION_VERTEX_ALLOWED_PROJECT_IDS=
# Optional IP addresses used as Docker's external DNS upstreams. Docker's
# embedded resolver continues to resolve Compose names such as api and scanner.
# On a corporate/VPN network that blocks public DNS, replace both with the
# organization-approved DNS resolver IPs.
COORDINATION_HOST_DNS_PRIMARY=1.1.1.1
COORDINATION_HOST_DNS_SECONDARY=8.8.8.8
